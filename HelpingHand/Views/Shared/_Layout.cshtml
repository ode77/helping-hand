@if (User.Identity!.IsAuthenticated)
{
    <li class="nav-item">
        <a class="nav-link text-white"
           asp-controller="HelpRequest"
           asp-action="Create">Post Request</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white"
           asp-controller="Account"
           asp-action="Dashboard">My Dashboard</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white position-relative"
               asp-controller="Notification"
               asp-action="Index">
            🔔 Notifications
            @{
                var notifCount = 0;
                if (User.Identity!.IsAuthenticated)
                {
                    var notifRepo = Context.RequestServices
                        .GetService<HelpingHand.Repositories
                        .INotificationRepository>();
                    if (notifRepo != null)
                    {
                        var uid = Context.User.FindFirst(
                            System.Security.Claims
                            .ClaimTypes.NameIdentifier)?.Value;
                        if (uid != null)
                            notifCount = await notifRepo
                                .GetUnreadCountAsync(uid);
                    }
                }
            }
            @if (notifCount > 0)
            {
                <span class="position-absolute top-0 start-100
                    translate-middle badge
                    rounded-pill bg-danger"
                      style="font-size:0.65rem;">
                    @notifCount
                </span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-white"
           asp-controller="Account"
           asp-action="Profile">My Profile</a>
    </li>
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link text-warning"
               asp-controller="Admin"
               asp-action="Index">Admin Panel</a>
        </li>
    }
    <li class="nav-item">
        <form asp-controller="Account"
              asp-action="Logout" method="post">
            <button type="submit"
                    class="nav-link btn btn-link text-white">
                Logout
            </button>
        </form>
    </li>
}