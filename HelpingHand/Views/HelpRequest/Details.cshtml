@model HelpingHand.Models.HelpRequest
@using System.Security.Claims

@{
    ViewData["Title"] = "Request Details";
    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<a asp-controller="Home" asp-action="Board"
   class="btn btn-outline-secondary btn-sm mb-3">← Back to Board</a>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h3 style="color:#1F3864;">@Model.Title</h3>
            <div>
                <span class="badge bg-primary me-1">@Model.Category?.Name</span>
                @await Html.PartialAsync("_StatusBadge", Model.Status)
            </div>
        </div>

        <p class="text-muted small mb-3">
            Posted by: <strong>@Model.Requester?.FullName</strong>
            · @Model.CreatedAt.ToString("dd MMM yyyy")
            @if (Model.PreferredDate.HasValue)
            {
                <span> · Preferred date: @Model.PreferredDate.Value.ToString("dd MMM yyyy")</span>
            }
        </p>

        <hr />
        <p>@Model.Description</p>
        <hr />

        <div class="mt-3">
            @if (User.Identity!.IsAuthenticated &&
                 Model.Status == HelpingHand.Models.RequestStatus.Open &&
                 Model.RequesterId != userId)
            {
                <form asp-action="Claim" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.HelpRequestId" />
                    <button type="submit" class="btn btn-primary">
                        Claim This Request
                    </button>
                </form>
            }

            @if (Model.Status == HelpingHand.Models.RequestStatus.Assigned &&
                 (Model.VolunteerId == userId || Model.RequesterId == userId))
            {
                <form asp-action="Complete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.HelpRequestId" />
                    <button type="submit" class="btn btn-success">
                        Mark as Completed
                    </button>
                </form>
            }

            @if (Model.Status == HelpingHand.Models.RequestStatus.Open &&
                 Model.RequesterId == userId)
            {
                <form asp-action="Cancel" method="post" class="d-inline ms-2">
                    <input type="hidden" name="id" value="@Model.HelpRequestId" />
                    <button type="submit" class="btn btn-outline-danger">
                        Cancel Request
                    </button>
                </form>
            }
        </div>
    </div>
</div>