@{
    ViewData["Title"] = "Assign Volunteer";
    var users = ViewBag.Users as List<HelpingHand.Models.ApplicationUser>;
}

<a asp-action="Index"
       class="btn btn-outline-secondary btn-sm mb-3">
    ← Back to Admin Panel
</a>

<h3 style="color:#1F3864;">Assign Volunteer</h3>
<p class="text-muted">
    Request: <strong>@ViewBag.RequestTitle</strong>
</p>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-action="AssignVolunteer" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId"
                   value="@ViewBag.RequestId" />

            <div class="mb-3">
                <label class="form-label fw-bold">
                    Select Volunteer
                </label>
                <select name="volunteerId" class="form-select">
                    <option value="">-- Select a volunteer --</option>
                    @foreach (var user in users ?? new List<HelpingHand.Models.ApplicationUser>())
                    {
                        <option value="@user.Id">
                            @user.FullName — @user.Email
                            (@user.Availability)
                        </option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Assign Volunteer
            </button>
        </form>
    </div>
</div>