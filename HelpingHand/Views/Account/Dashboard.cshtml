@model HelpingHand.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "My Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 style="color:#1F3864;">Welcome, @Model.UserFullName!</h2>
    <a asp-controller="HelpRequest" asp-action="Create"
       class="btn btn-primary">+ Post New Request</a>
</div>

<ul class="nav nav-tabs mb-3" id="dashTabs">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab"
                data-bs-target="#posted">
            My Requests (@Model.PostedRequests.Count())
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab"
                data-bs-target="#helping">
            Helping With (@Model.ClaimedRequests.Count())
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab"
                data-bs-target="#completed">
            Completed (@Model.CompletedRequests.Count())
        </button>
    </li>
</ul>

<div class="tab-content">

    <div class="tab-pane fade show active" id="posted">
        @if (!Model.PostedRequests.Any())
        {
            <p class="text-muted">You have not posted any active requests.</p>
        }
        else
        {
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Posted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.PostedRequests)
                    {
                        <tr>
                            <td>@r.Title</td>
                            <td>@await Html.PartialAsync("_StatusBadge", r.Status)</td>
                            <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-controller="HelpRequest"
                                   asp-action="Details"
                                   asp-route-id="@r.HelpRequestId"
                                   class="btn btn-outline-primary btn-sm">View</a>
                                @if (r.Status == HelpingHand.Models.RequestStatus.Open)
                                {
                                    <form asp-controller="HelpRequest"
                                          asp-action="Cancel" method="post"
                                          class="d-inline ms-1">
                                        <input type="hidden" name="id"
                                               value="@r.HelpRequestId" />
                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm">
                                            Cancel
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="tab-pane fade" id="helping">
        @if (!Model.ClaimedRequests.Any())
        {
            <p class="text-muted">You are not currently helping with any requests.</p>
        }
        else
        {
            <table class="table table-hover">
                <thead class="table-light">
                    <tr><th>Title</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.ClaimedRequests)
                    {
                        <tr>
                            <td>@r.Title</td>
                            <td>@await Html.PartialAsync("_StatusBadge", r.Status)</td>
                            <td>
                                <form asp-controller="HelpRequest"
                                      asp-action="Complete" method="post"
                                      class="d-inline">
                                    <input type="hidden" name="id"
                                           value="@r.HelpRequestId" />
                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        Mark Complete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="tab-pane fade" id="completed">
        @if (!Model.CompletedRequests.Any())
        {
            <p class="text-muted">No completed requests yet.</p>
        }
        else
        {
            <table class="table table-hover">
                <thead class="table-light">
                    <tr><th>Title</th><th>Completed</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.CompletedRequests)
                    {
                        <tr>
                            <td>@r.Title</td>
                            <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

</div>