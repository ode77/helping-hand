@model HelpingHand.ViewModels.RequestDetailsViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Request Details";
    var req = Model.Request;
    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<a asp-controller="Home" asp-action="Board"
       class="btn btn-outline-secondary btn-sm mb-3">
    ← Back to Board
</a>

<div class="card shadow-sm mb-4">
    <div class="card-body p-4">

        @* Title and badges *@
        <div class="d-flex justify-content-between
            align-items-start mb-2">
            <h3 style="color:#1F3864;">@req.Title</h3>
            <div>
                <span class="badge bg-primary me-1">
                    @req.Category?.Name
                </span>
                @await Html.PartialAsync(
                    "_StatusBadge", req.Status)
                @{
                    var (urgCss, urgLabel) = req.Urgency switch
                    {
                        HelpingHand.Models.RequestUrgency.Urgent
                            => ("bg-danger", "🔴 Urgent"),
                        HelpingHand.Models.RequestUrgency.Medium
                            => ("bg-warning text-dark", "🟡 Medium"),
                        _ => ("bg-success", "🟢 Low")
                    };
                }
                <span class="badge @urgCss ms-1">
                    @urgLabel
                </span>
            </div>
        </div>

        @* Meta info *@
        <p class="text-muted small mb-3">
            Posted by:
            <strong>@req.Requester?.FullName</strong>
            · @req.CreatedAt.ToString("dd MMM yyyy")
            · Expires: @req.ExpiresAt.ToString("dd MMM yyyy")
            @if (req.PreferredDate.HasValue)
            {
                <span>
                    · Preferred:
                    @req.PreferredDate.Value
                    .ToString("dd MMM yyyy")
                </span>
            }
        </p>

        @* Volunteer rating display *@
        @if (Model.RatingCount > 0)
        {
            <p class="text-muted small">
                Volunteer rating:
                @for (int i = 1; i <= 5; i++)
                {
                    <span style="color:@(i <= Model.AverageRating
                                                                      ? "#ffc107" : "#ccc")">★</span>
            }
            (@Model.AverageRating.ToString("F1") / 5
            from @Model.RatingCount review(s))
        </p>
    }

    <hr />
    <p>@req.Description</p>
    <hr />

    @* Requester sees applicants *@
    @if (userId == req.RequesterId &&
         req.Status ==
             HelpingHand.Models.RequestStatus.Open &&
         Model.Applications.Any())
    {
        <h5 class="mt-3">Volunteer Applications</h5>
        @foreach (var app in Model.Applications)
        {
            <div class="card mb-2 border-info">
                <div class="card-body py-2 px-3">
                    <strong>@app.Volunteer?.FullName</strong>
                    <span class="text-muted small ms-2">
                        @app.AppliedAt
                        .ToString("dd MMM yyyy HH:mm")
                    </span>
                    @if (app.IdVerified)
                    {
                        <span class="badge bg-success ms-2">
                            ✅ ID Verified
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning
                            text-dark ms-2">
                            ⏳ ID Pending Verification
                        </span>
                    }
                    <p class="mb-1 mt-1">@app.Message</p>
                    @if (!app.IsAccepted)
                    {
                        <form asp-action="AcceptApplication"
                              method="post"
                              class="d-inline">
                            <input type="hidden"
                                   name="applicationId"
                                   value="@app.VolunteerApplicationId" />
                            <button type="submit"
                                    class="btn btn-success btn-sm">
                                Accept This Volunteer
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Accepted
                        </span>
                    }
                </div>
            </div>
        }
    }

    @* Volunteer applies *@
    @if (User.Identity!.IsAuthenticated &&
         userId != req.RequesterId &&
         req.Status ==
             HelpingHand.Models.RequestStatus.Open &&
         !Model.AlreadyApplied)
    {
        <div class="mt-3">
            <h5>Apply to Help</h5>
            <form asp-action="Apply" method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden"
                       name="HelpRequestId"
                       value="@req.HelpRequestId" />
                <input type="hidden"
                       name="RequestTitle"
                       value="@req.Title" />

                <div class="mb-2">
                    <label class="form-label fw-bold">
                        Why can you help?
                    </label>
                    <textarea name="Message"
                              rows="3"
                              class="form-control"
                              placeholder="Briefly explain why you can help..."
                              maxlength="500"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Upload ID Document
                        <span class="text-danger">*</span>
                    </label>
                    <input type="file"
                           name="IdDocument"
                           class="form-control"
                           accept="image/*,.pdf" />
                    <div class="form-text">
                        Required — upload a photo or scan
                        of your ID (passport, driving licence, etc.)
                    </div>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Submit Application
                </button>
            </form>
        </div>
    }
    else if (Model.AlreadyApplied &&
             req.Status ==
                 HelpingHand.Models.RequestStatus.Open)
    {
        <div class="alert alert-info mt-3">
            You have already applied for this request.
            The requester will review applications.
        </div>
    }

    @* Contact info for assigned volunteer *@
    @if (req.Status ==
             HelpingHand.Models.RequestStatus.Assigned &&
         req.VolunteerId == userId)
    {
        <hr />
        <div class="alert alert-info mt-3">
            <h6 class="fw-bold">
                Requester Contact Details
            </h6>
            <p class="mb-1">
                <strong>Name:</strong>
                @req.Requester?.FullName
            </p>
            <p class="mb-1">
                <strong>Phone:</strong>
                <a href="tel:@req.Requester?.PhoneNumber">
                    @req.Requester?.PhoneNumber
                </a>
            </p>
            <p class="mb-1">
                <strong>Address:</strong>
                @req.Requester?.Address
            </p>
            <p class="mb-0">
                <strong>Availability:</strong>
                @req.Requester?.Availability
            </p>
        </div>
    }

    @* ACTION BUTTONS *@
    <div class="mt-3">

        @* Volunteer marks done *@
        @if (req.Status ==
                 HelpingHand.Models.RequestStatus.Assigned &&
             req.VolunteerId == userId)
        {
            <form asp-action="VolunteerMarkDone"
                  method="post" class="d-inline">
                <input type="hidden" name="id"
                       value="@req.HelpRequestId" />
                <button type="submit"
                        class="btn btn-success"
                        onclick="return confirm(
                    'Are you sure you have completed this task?')">
                    I Have Completed This Task
                </button>
            </form>
        }

        @* Volunteer done — waiting for requester *@
        @if (req.Status ==
                 HelpingHand.Models.RequestStatus.VolunteerDone &&
             req.VolunteerId == userId)
        {
            <div class="alert alert-info mt-2">
                You have marked this as done.
                Waiting for
                <strong>@req.Requester?.FullName</strong>
                to confirm completion.
            </div>
        }

        @* Requester confirms completion *@
        @if (req.Status ==
                 HelpingHand.Models.RequestStatus.VolunteerDone &&
             req.RequesterId == userId)
        {
            <div class="alert alert-warning">
                <strong>@req.Volunteer?.FullName</strong>
                has marked this task as done.
                Please confirm and leave feedback.
            </div>
            <a asp-action="ConfirmComplete"
                   asp-route-id="@req.HelpRequestId"
                   class="btn btn-primary">
                Confirm and Leave Feedback
            </a>
        }

        @* Cancel — only for open requests by requester *@
        @if (req.Status ==
                 HelpingHand.Models.RequestStatus.Open &&
             req.RequesterId == userId)
        {
            <form asp-action="Cancel" method="post"
                  class="d-inline ms-2">
                <input type="hidden" name="id"
                       value="@req.HelpRequestId" />
                <button type="submit"
                        class="btn btn-outline-danger">
                    Cancel Request
                </button>
            </form>

            <a asp-action="SaveTemplate"
                   asp-route-id="@req.HelpRequestId"
                   class="btn btn-outline-secondary ms-2">
                Save as Template
            </a>
        }

        @* Show feedback on completed requests *@
        @if (req.Status ==
                 HelpingHand.Models.RequestStatus.Completed &&
             !string.IsNullOrEmpty(req.RequesterFeedback))
        {
            <div class="alert alert-success mt-3">
                <strong>Requester feedback:</strong>
                @req.RequesterFeedback
            </div>
        }

    </div>

    @* Comments section *@
    @if (req.Status ==
             HelpingHand.Models.RequestStatus.Assigned ||
         req.Status ==
             HelpingHand.Models.RequestStatus.VolunteerDone ||
         req.Status ==
             HelpingHand.Models.RequestStatus.Completed)
    {
        <hr class="mt-4" />
        <h5>Comments and Updates</h5>

        @foreach (var comment in Model.Comments)
        {
            <div class="card mb-2
                @(comment.AuthorId == userId
                                         ? "border-primary" : "")">
                <div class="card-body py-2 px-3">
                    <strong>@comment.Author?.FullName</strong>
                    <span class="text-muted small ms-2">
                        @comment.PostedAt
                        .ToString("dd MMM HH:mm")
                    </span>
                    <p class="mb-0 mt-1">
                        @comment.Content
                    </p>
                </div>
            </div>
        }

        @if (User.Identity!.IsAuthenticated &&
             (userId == req.RequesterId ||
              userId == req.VolunteerId))
        {
            <form asp-action="AddComment"
                  method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden"
                       name="requestId"
                       value="@req.HelpRequestId" />
                <div class="input-group">
                    <input type="text"
                           name="content"
                           class="form-control"
                           placeholder="Add an update or message..."
                           maxlength="500" />
                    <button type="submit"
                            class="btn btn-primary">
                        Post
                    </button>
                </div>
            </form>
        }
    }

</div>
</div>