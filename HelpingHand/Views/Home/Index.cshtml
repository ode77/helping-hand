@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5" style="background-color:#EAF2FF; border-radius:12px;">
    <h1 class="display-5 fw-bold" style="color:#1F3864;">
        Community Help, One Request at a Time
    </h1>
    <p class="lead text-muted mt-2">
        Supporting neighbours through everyday tasks — no payment, just community.
    </p>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Board"
           class="btn btn-primary btn-lg me-3">Browse Help Board</a>
        <a asp-controller="Account" asp-action="Register"
           class="btn btn-outline-primary btn-lg">Register to Help</a>
    </div>
</div>