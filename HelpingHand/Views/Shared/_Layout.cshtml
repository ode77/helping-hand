<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Helping Hand</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
        }
        .navbar-brand {
            letter-spacing: 1px;
        }
        .card {
            border-radius: 10px;
        }
        footer {
            background-color: #1F3864;
            color: #ffffff;
        }
    </style>
</head>
<body>

    @* Navigation bar *@
    <nav class="navbar navbar-expand-lg shadow-sm"
         style="background-color:#1F3864;">
        <div class="container">

            <a class="navbar-brand text-white fw-bold"
               asp-controller="Home"
               asp-action="Index">
                HELPING HAND
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navMenu"
                    aria-controls="navMenu"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-center">

                    <li class="nav-item">
                        <a class="nav-link text-white"
                           asp-controller="Home"
                           asp-action="Board">
                            Help Board
                        </a>
                    </li>

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="HelpRequest"
                               asp-action="Create">
                                Post Request
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Account"
                               asp-action="Dashboard">
                                My Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Account"
                               asp-action="Profile">
                                My Profile
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white position-relative"
                               asp-controller="Notification"
                               asp-action="Index">
                                🔔 Notifications
                                @{
                                    var notifCount = 0;
                                    try
                                    {
                                        var notifRepo = Context
                                            .RequestServices
                                            .GetService<HelpingHand
                                            .Repositories
                                            .INotificationRepository>();
                                        if (notifRepo != null)
                                        {
                                            var uid = Context.User
                                                .FindFirst(System.Security
                                                .Claims.ClaimTypes
                                                .NameIdentifier)?.Value;
                                            if (uid != null)
                                                notifCount = await notifRepo
                                                    .GetUnreadCountAsync(uid);
                                        }
                                    }
                                    catch { }
                                }
                                @if (notifCount > 0)
                                {
                                    <span class="position-absolute
                                                 top-0 start-100
                                                 translate-middle
                                                 badge rounded-pill
                                                 bg-danger"
                                          style="font-size:0.65rem;">
                                        @notifCount
                                    </span>
                                }
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold"
                                   asp-controller="Admin"
                                   asp-action="Index">
                                    ⚙ Admin Panel
                                </a>
                            </li>
                        }

                        <li class="nav-item ms-2">
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-outline-light btn-sm">
                                    Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item ms-2">
                            <a class="btn btn-light btn-sm"
                               asp-controller="Account"
                               asp-action="Register">
                                Register
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    @* Success notification *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible
                    fade show m-3 shadow-sm"
             role="alert">
            <i class="me-2">✅</i> @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @* Error notification *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible
                    fade show m-3 shadow-sm"
             role="alert">
            <i class="me-2">❌</i> @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @* Main content area *@
    <main class="container my-4">
        @RenderBody()
    </main>

    @* Footer *@
    <footer class="py-4 mt-5">
        <div class="container text-center">
            <p class="mb-1 fw-bold">HELPING HAND</p>
            <p class="mb-0 small text-white-50">
                Community Mutual Aid Platform —
                Connecting neighbours, one request at a time.
            </p>
        </div>
    </footer>

    @* Scripts *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>